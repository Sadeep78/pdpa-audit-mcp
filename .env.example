# pdpa-audit-mcp configuration

# SSRF Guard Override:
# Set to 'true' ONLY when auditing a local development server (e.g. http://localhost:3000, 127.0.0.1).
# By default, private/loopback/link-local/metadata IP addresses are blocked.
PDPA_AUDIT_ALLOW_PRIVATE=false

# Network politeness settings
PDPA_AUDIT_TIMEOUT_SECONDS=10.0
PDPA_AUDIT_FETCH_DEADLINE_SECONDS=20.0
PDPA_AUDIT_MAX_RESPONSE_BYTES=1048576
PDPA_AUDIT_MAX_REDIRECTS=3
PDPA_AUDIT_MAX_CRAWL_PAGES=10
PDPA_AUDIT_USER_AGENT=pdpa-audit-mcp/0.1 (+self-audit)

# Server settings
PDPA_AUDIT_HOST=127.0.0.1
PDPA_AUDIT_PORT=8765

# Bridge security: Refuse binding non-local hosts unless set to true
PDPA_BRIDGE_ALLOW_NON_LOCAL=false

# Access Control: Allowed directory roots for local audits (os.pathsep-separated list)
# If set, local targets/paths must resolve within one of these roots.
# If unset, defaults to the current working directory as the single allowed root.
# Windows example: PDPA_AUDIT_ALLOWED_ROOTS=C:\Users\DELL\projects;D:\workspace
# Linux/macOS example: PDPA_AUDIT_ALLOWED_ROOTS=/home/user/projects:/var/www
PDPA_AUDIT_ALLOWED_ROOTS=
